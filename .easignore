# Cloud native builds contain the LieferDank app and its two pure card modules.
# Web/backend sources, personal files, production env and test data stay local.
/*
!/apps
/apps/*
!/apps/driver
/apps/driver/node_modules
/apps/driver/.expo
/apps/driver/dist
/apps/driver/ios
/apps/driver/android
/apps/driver/coverage
!/src
/src/*
!/src/lib
/src/lib/*
!/src/lib/card
/src/lib/card/*
!/src/lib/card/design.ts
!/src/lib/card/svg.ts
**/.env
**/.env.*
**/*.pem
**/*.p12
**/*.p8
**/*.jks
**/*.keystore
**/*.mobileprovision
**/credentials.json
**/GoogleService-Info.plist
**/google-services.json
**/.DS_Store
**/*.tsbuildinfo
**/npm-debug.log*
