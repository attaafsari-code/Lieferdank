{
  "name": "lieferdank-driver",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "export": "expo export --platform ios --platform android",
    "build:ios": "npm run release:preflight && npx --yes eas-cli@24.12.0 build --platform ios --profile production",
    "build:android": "npm run release:preflight && npx --yes eas-cli@24.12.0 build --platform android --profile production",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "57.0.27",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
