# =============================================================================
# Lieferdank – Umgebungsvariablen
#
# Kopieren nach .env.local (lokal) bzw. in Vercel → Settings → Environment
# Variables (Produktion). Für den lokalen Testmodus muss NICHTS gesetzt sein.
# Vollständige Erklärung: DEPLOYMENT.md
# =============================================================================

# --- Adressen ----------------------------------------------------------------
# Ziel aller QR-Codes. Produktion: https://lieferdank.de
# In Produktion werden localhost, http und private IPs ignoriert (Fallback lieferdank.de).
# Lokal leer lassen: dann nimmt die App die WLAN-Adresse des Rechners, damit ein
# Handy im selben WLAN den QR-Code scannen kann.
NEXT_PUBLIC_BASE_URL=

# Adresse für canonical-Links und Sitemap. Default in Produktion: https://lieferdank.de
NEXT_PUBLIC_SITE_URL=

# --- Sicherheit (Produktion: PFLICHT) ----------------------------------------
# Signiert Sessions und App-Tokens. Mindestens 32 Zeichen.
# Erzeugen: openssl rand -base64 48
AUTH_SECRET=

# --- Datenbank ---------------------------------------------------------------
# memory   = lokale Testdatenbank in data/db.json
# supabase = Postgres + Storage über Supabase (Feldtest und Produktion)
LIEFERDANK_DB=memory
SUPABASE_URL=
# NUR serverseitig. Niemals als NEXT_PUBLIC_ oder im Frontend verwenden.
SUPABASE_SERVICE_ROLE_KEY=
# Privater Bucket für Profilfotos (wird von supabase/schema.sql angelegt)
SUPABASE_STORAGE_BUCKET=media

# --- Zahlungen ---------------------------------------------------------------
# demo   = Testmodus, simulierte Bezahlmaske, kein Geld
# stripe = Stripe Connect + Checkout (Apple Pay, Google Pay, Karte; PayPal später)
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Zweiter Webhook für Ereignisse auf verbundenen Konten (Connect) – eigenes Secret
STRIPE_CONNECT_WEBHOOK_SECRET=

# Kalkulationssätze für die Margenanzeige im Admin (keine Abrechnung!)
PAYMENT_FEE_PERCENT=1.5
PAYMENT_FEE_FIXED_CENTS=25
PAYOUT_FEE_PERCENT=0.25
PAYOUT_FEE_FIXED_CENTS=10

# --- Kartenbestellungen ------------------------------------------------------
# true = Plastikkarten werden über Stripe bezahlt (Preise in src/lib/pricing.ts)
# leer = Bestellungen sind kostenlos (Testbetrieb)
CARD_ORDERS_PAID=

# --- E-Mail (Resend) ---------------------------------------------------------
# Ohne Key wird nichts versendet; in Produktion ist Passwort-Reset dann nicht verfügbar.
RESEND_API_KEY=
MAIL_FROM="Lieferdank <noreply@lieferdank.de>"
MAIL_REPLY_TO=
