# ---------------------------------------------------------------------------
# Lieferdank – Umgebungsvariablen
# Kopiere diese Datei nach .env.local und passe die Werte an.
# Für den lokalen Testmodus muss nichts davon gesetzt sein.
# ---------------------------------------------------------------------------

# --- Adressen --------------------------------------------------------------
# Adresse, die in die QR-Codes geschrieben wird. MUSS in Produktion gesetzt sein.
# Lokal leer lassen: Dann wird automatisch die LAN-Adresse dieses Rechners
# verwendet, damit ein Handy im selben WLAN den QR-Code scannen kann.
NEXT_PUBLIC_BASE_URL=

# Öffentliche Marken-Adresse für canonical-Links und Sitemap.
# Default in Produktion: https://lieferdank.de
NEXT_PUBLIC_SITE_URL=

# --- Sicherheit ------------------------------------------------------------
# Signaturschlüssel für Session-Cookies. In Produktion PFLICHT, mind. 32 Zeichen.
# Erzeugen: openssl rand -base64 48
AUTH_SECRET=

# --- Datenbank -------------------------------------------------------------
# memory   = lokale Testdatenbank (data/db.json), ideal zum Ausprobieren
# supabase = Postgres über Supabase (Feldtest und Produktion)
LIEFERDANK_DB=memory

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Zahlungen -------------------------------------------------------------
# demo   = Zahlungen werden simuliert, es fließt kein Geld
# stripe = Stripe Connect (Test- oder Live-Keys)
PAYMENT_PROVIDER=demo

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Kalkulationssätze für die Margenanzeige im Adminbereich.
# Default entspricht Stripe DE Karten (1,5 % + 0,25 €).
PAYMENT_FEE_PERCENT=1.5
PAYMENT_FEE_FIXED_CENTS=25

# --- E-Mail ----------------------------------------------------------------
# Wird für "Passwort vergessen" gebraucht. Ohne Key wird nichts versendet:
# Der Link erscheint dann direkt im Browser und im Serverlog.
RESEND_API_KEY=
MAIL_FROM="Lieferdank <noreply@lieferdank.de>"
